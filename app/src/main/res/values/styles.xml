<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme.Base" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/canvas</item>
        <item name="android:colorAccent">@color/clinical</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="android:alertDialogTheme">@style/MedicalDialog</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/canvas</item>
        <item name="android:navigationBarColor">@color/canvas</item>
    </style>
    <style name="AppTheme" parent="AppTheme.Base"/>
    <style name="MedicalDialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/medical_card</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="android:colorAccent">@color/clinical</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>
    </style>
    <style name="FieldLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>
    <style name="LocationField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/medical_field</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>
</resources>
